<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme: launch window only, aligned with the
         forced-light Compose "OrgUtil Teal Light" scheme. -->
    <style name="Base.Theme.OrgUtil" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/orgutil_teal</item>
        <item name="colorPrimaryVariant">@color/orgutil_teal_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/teal_700</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.OrgUtil" parent="Base.Theme.OrgUtil" />

    <!-- Dialog theme for quick capture -->
    <style name="Theme.OrgUtil.Dialog" parent="Theme.Material3.Light.Dialog">
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>
</resources>
