<?xml version="1.0" encoding="utf-8"?>
<!-- Inner core of the TODAY marker's two-tone ring: inset 1dp by the
     layer-lists that reference it, so it reads as a dark ring with a thin
     white outer edge around the whole cell. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#00000000" />
    <stroke android:width="1dp" android:color="#172624" />
    <corners android:radius="2dp" />
</shape>
