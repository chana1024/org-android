<?xml version="1.0" encoding="utf-8"?>
<!-- KRAFT LEDGER twin of widget_background.xml (quick-capture shell) —
     card #E4DFD3 with the #B5AD9B border; same layered shadow geometry. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow layer -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#33000000" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- Main background -->
    <item android:bottom="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#E4DFD3" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#B5AD9B" />
        </shape>
    </item>
</layer-list>
