<?xml version="1.0" encoding="utf-8"?>
<!-- MISSED cell fill: dedicated warm brick red at FULL strength (never a
     dim variant — a missed day must never pass for a future one). Mirrors
     AgendaScreen.HabitMissedColor #8C1D1A exactly; deliberately deeper
     than the overdue face's #C4451A (widget_habit_overdue), which keeps
     marking today/future overdue schedule status. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#8C1D1A" />
    <corners android:radius="2dp" />
</shape>
