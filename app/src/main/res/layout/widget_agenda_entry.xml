<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_agenda_entry_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_agenda_entry_background"
    android:gravity="center_vertical"
    android:minHeight="36dp"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingEnd="8dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_agenda_entry_indent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#66807C"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/widget_agenda_entry_todo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_agenda_todo_background"
            android:gravity="center"
            android:minWidth="34dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="#315A56"
            android:textSize="10sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_agenda_entry_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#172624"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/widget_agenda_entry_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#55706D"
            android:textSize="9sp" />
        <!-- Per-entry pomodoro trigger, mirroring the in-app row's timer
             button. Its fill-in intent (set by the factory) carries the
             exact row identity plus a flag DISTINCT from the root-open and
             TODO-chooser fill-ins, so a timer tap can never open the file
             editor or the keyword dialog. Baked launcher-safe drawables;
             the title keeps its weight and ellipsizes. -->
        <ImageView
            android:id="@+id/widget_agenda_entry_pomodoro"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_pomodoro_button_background"
            android:contentDescription="为此条目启动番茄钟"
            android:padding="5dp"
            android:scaleType="centerInside"
            android:src="@drawable/widget_pomodoro_icon" />
    </LinearLayout>
    <!-- WAIT 等待原因 summary: the current note's first line or two, subdued
         under the title, visible ONLY on WAIT rows that carry a note (the
         factory flips visibility per row). No own click handler — taps ride
         the root's existing fill-in intent, same as the title itself. Kept
         to maxLines=2 and 9sp so a long reason can never balloon the card;
         marginStart aligns it under the title, past the badge column. -->
    <TextView
        android:id="@+id/widget_agenda_entry_wait_reason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#55706D"
        android:textSize="9sp"
        android:visibility="gone" />
    <!-- Habit consistency strip: 21 days before today + today + 7 after, one
         weighted cell per day (mirrors HabitConsistencyGraph in AgendaScreen:
         face-colored cell, dimmed past/future at 30%, done = centered 5dp dot,
         today = full-cell two-tone outline + a caret cue directly beneath the
         today cell so the current day is findable at widget scale; reliably
         missed days = brick-red widget_habit_missed fill + two-tone × marker).
         Only launcher-safe RemoteViews operations are used:
         setImageViewResource / setViewVisibility / setContentDescription per
         cell. Marker ImageViews span the whole cell; each marker drawable
         carries its own geometry. -->
    <LinearLayout
        android:id="@+id/widget_agenda_habit_graph"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="vertical"
        android:visibility="gone">
