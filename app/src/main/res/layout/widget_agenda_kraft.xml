<?xml version="1.0" encoding="utf-8"?>
<!-- KRAFT LEDGER twin of widget_agenda.xml — structure and view IDs are IDENTICAL; only colors/drawables differ. Any structural edit must be applied to BOTH files. Generated from the classic original by palette substitution. Header stays the COLORED token (#C8C1B1 family) with ink text, per the approved design — never a dark header. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_agenda_background_kraft">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="2dp"
        android:paddingTop="2dp"
        android:paddingBottom="6dp">
        <LinearLayout
            android:id="@+id/widget_agenda_open"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agenda"
                android:textColor="#26231D"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_agenda_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daily"
                android:textColor="#5A5446"
                android:textSize="12sp" />
        </LinearLayout>
        <!-- 总目标 button merged with the goal statistics: two compact
             lines inside the old 40dp pill footprint. Line 2 renders the
             SAME shared snapshot as the Agenda stats card (已完成 n/m plus
             当前周期 h/t, abbreviated for width; full labelled form goes in
             the content description). wrap_content keeps every numeric
             value unclipped — the weighted title yields space first. The
             whole pill stays the goal-detail tap target. -->
        <LinearLayout
            android:id="@+id/widget_agenda_goal"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_agenda_goal_background_kraft"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">
            <TextView
                android:id="@+id/widget_agenda_goal_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="总目标"
                android:textColor="#5A5446"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_agenda_goal_stats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text=""
                android:textColor="#34302A"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
        <TextView
            android:id="@+id/widget_agenda_refresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Refresh Agenda"
            android:gravity="center"
            android:text="↻"
            android:textColor="#34302A"
            android:textSize="26sp"
            android:background="@drawable/widget_agenda_refresh_background_kraft" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_pomodoro_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@drawable/widget_agenda_timer_background_kraft"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_pomodoro_phase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FOCUS"
                android:textColor="#34302A"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_pomodoro_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#26231D"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
        <Chronometer
            android:id="@+id/widget_pomodoro_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:countDown="true"
            android:format="%s"
            android:textColor="#26231D"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_pomodoro_zero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#26231D"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <ListView
        android:id="@+id/widget_agenda_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="2dp"
        android:scrollbars="vertical"
        android:cacheColorHint="@android:color/transparent"
        android:paddingBottom="4dp"
        android:clipToPadding="false" />
</LinearLayout>
